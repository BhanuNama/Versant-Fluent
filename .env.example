# ---- Core ----
NODE_ENV=development
PORT=8787
# Leave empty to use the built-in file store (data/db.json). Set for MongoDB Atlas M0 or local Mongo.
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Cross-site deploys (Vercel web + Render API) need: COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
ADMIN_EMAILS=

# ---- Providers (all optional, all free tiers) ----
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LANGUAGETOOL_URL=https://api.languagetool.org
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Model overrides (verify current free models before launch)
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Daily request budgets per provider (switch provider / queue when reached)
BUDGET_GROQ=900
BUDGET_GEMINI=1200
BUDGET_OPENROUTER=180
BUDGET_LANGUAGETOOL=1500

# Judge runs per model (spec: 2 models x 2 runs). With one model, 3 runs are used.
JUDGE_RUNS=2
# local = all-MiniLM-L6-v2 via transformers.js (downloads once), overlap = token overlap only
EMBEDDINGS=local

# ---- Web (Vite) ----
# Only for production cross-origin deploys, e.g. https://fluentpath-api.onrender.com
VITE_API_URL=
